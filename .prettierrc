{
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "plugins": ["@ianvs/prettier-plugin-sort-imports", "prettier-plugin-tailwindcss"],
  "importOrder": [
    "<BUILTIN_MODULES>",
    "",
    "<THIRD_PARTY_MODULES>",
    "",
    "^@tickethub/",
    "",
    "^@/",
    "",
    "^[.]"
  ],
  "importOrderTypeScriptVersion": "5.5.0",
  "tailwindStylesheet": "./apps/web-organizer/app/globals.css",
  "tailwindFunctions": ["cn", "cva"]
}
