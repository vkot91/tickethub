DATABASE_URL=postgres://tickethub:tickethub@localhost:5432/tickethub
# Integration suites only — they TRUNCATE and re-seed this database on every run.
TEST_DATABASE_URL=postgres://tickethub:tickethub@localhost:5432/tickethub_test
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672
# Orders: how long a seat reservation is held before auto-expiry (seconds). Default 600 (10 min).
RESERVATION_TTL_SEC=600
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
NODE_ENV=development
# Stripe (test mode only — never commit live keys). stripe-cli prints the whsec on `listen`.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=tickethub
S3_SECRET_KEY=tickethub
S3_BUCKET_POSTERS=posters
S3_BUCKET_TICKETS=tickets
# Mailpit (local fake SMTP) — apps/fulfillment emails the PDF ticket here.
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=tickets@tickethub.local
# Min 32 chars — obviously-fake placeholder; generate a real one with `openssl rand -hex 32`.
TICKET_QR_SECRET=replace-me-with-a-32-plus-char-random-hex-string
# Grafana Loki — apps push structured logs here (view them at http://localhost:3001).
LOKI_URL=http://localhost:3100
