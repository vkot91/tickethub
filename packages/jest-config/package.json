{
  "name": "@tickethub/jest-config",
  "version": "0.0.0",
  "private": true,
  "main": "dist/base.js",
  "files": [
    "dist"
  ],
  "exports": {
    "./base": {
      "types": "./dist/base.d.ts",
      "default": "./dist/base.js"
    },
    "./nest": {
      "types": "./dist/nest.d.ts",
      "default": "./dist/nest.js"
    },
    "./nest-db": {
      "types": "./dist/nest-db.d.ts",
      "default": "./dist/nest-db.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "lint": "eslint src"
  },
  "dependencies": {
    "ts-jest": "catalog:"
  },
  "devDependencies": {
    "@tickethub/tsconfig": "workspace:*",
    "@tickethub/eslint-config": "workspace:*",
    "jest": "catalog:",
    "typescript": "catalog:",
    "@types/node": "catalog:"
  }
}
