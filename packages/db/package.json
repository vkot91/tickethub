{
  "name": "@tickethub/db",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./nest": {
      "types": "./dist/nest.d.ts",
      "development": "./src/nest.ts",
      "default": "./dist/nest.js"
    },
    "./seed": {
      "types": "./dist/seed/index.d.ts",
      "development": "./src/seed/index.ts",
      "default": "./dist/seed/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "development": "./src/testing/index.ts",
      "default": "./dist/testing/index.js"
    },
    "./testing/jest.setup": {
      "types": "./dist/testing/jest.setup.d.ts",
      "development": "./src/testing/jest.setup.ts",
      "default": "./dist/testing/jest.setup.js"
    },
    "./testing/integration-env": {
      "types": "./dist/testing/integration-env.d.ts",
      "development": "./src/testing/integration-env.ts",
      "default": "./dist/testing/integration-env.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src",
    "test": "jest --coverage",
    "test:integration": "jest --testPathIgnorePatterns=/node_modules/ --testMatch='**/*.integration.spec.ts' --coverage=false --forceExit --runInBand --setupFiles @tickethub/db/testing/integration-env",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:test": "drizzle-kit migrate --config=drizzle.test.config.ts",
    "db:studio": "drizzle-kit studio",
    "db:dbml": "tsx dbml.ts",
    "db:seed": "tsx src/seed/index.ts",
    "db:reset": "tsx src/reset.ts && drizzle-kit migrate"
  },
  "dependencies": {
    "@nestjs/common": "catalog:",
    "@tickethub/config": "workspace:*",
    "@tickethub/env": "workspace:*",
    "drizzle-orm": "catalog:",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@tickethub/jest-config": "workspace:*",
    "@tickethub/tsconfig": "workspace:*",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "drizzle-dbml-generator": "^0.9.0",
    "drizzle-kit": "^0.24.0",
    "jest": "catalog:",
    "ts-jest": "catalog:",
    "ts-node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
